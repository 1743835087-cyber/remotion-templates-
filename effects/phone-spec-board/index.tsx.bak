interface SpecCardProps {
  index: number;
  iconType: "cpu" | "screen" | "battery" | "camera" | "body" | "price";
  label: string;
  value: string;
  lines: string[];
  isPriceCard?: boolean;
}

const SpecCard: React.FC<SpecCardProps> = ({
  index,
  iconType,
  label,
  value,
  lines,
  isPriceCard,
}) => {
  const frame = useCurrentFrame();
  const { fps } = useVideoConfig();

  const startFrame = 14 + index * 7;
  const enterProgress = spring({
    frame: frame - startFrame,
    fps,
    config: { damping: 24, stiffness: 115, mass: 0.95 },
  });

  const sheenX = interpolate(frame, [startFrame + 6, startFrame + 75], [-90, 150], {
    extrapolateLeft: "clamp",
    extrapolateRight: "clamp",
  });

  const priceHighlightOpacity = isPriceCard
    ? interpolate(frame, [78, 96], [0, 1], {
        extrapolateLeft: "clamp",
        extrapolateRight: "clamp",
      })
    : 0;

  const pulseGlow = isPriceCard ? 0.85 + Math.sin(frame / 10) * 0.15 : 0;

  return (
    <div
      style={{
        position: "relative",
        height: 256,
        padding: "24px 30px",
        boxSizing: "border-box",
        background:
          "linear-gradient(130deg, rgba(255,255,255,0.13) 0%, rgba(255,255,255,0.05) 50%, rgba(255,255,255,0.09) 100%)",
        border: isPriceCard
          ? "1px solid rgba(255,255,255,0.35)"
          : "1px solid rgba(255,255,255,0.2)",
        boxShadow: isPriceCard
          ? `inset 0 1px 0 rgba(255,255,255,0.28), 0 14px 36px rgba(0,0,0,0.45), 0 0 ${
              28 * priceHighlightOpacity
            }px rgba(255,255,255,0.18)`
          : "inset 0 1px 0 rgba(255,255,255,0.2), 0 14px 34px rgba(0,0,0,0.38)",
        opacity: enterProgress,
        transform: `translateY(${(1 - enterProgress) * 32}px) scale(${
          0.97 + enterProgress * 0.03
        })`,
      }}
    >
      {/* Internal clipped layer for soft light falloff, sheen, and watermark */}
      <div
        style={{
          position: "absolute",
          inset: 0,
          overflow: "hidden",
          pointerEvents: "none",
        }}
      >
        {/* Animated entrance light sweep */}
        <div
          style={{
            position: "absolute",
            inset: -80,
            background:
              "linear-gradient(118deg, transparent 36%, rgba(255,255,255,0.04) 45%, rgba(255,255,255,0.14) 50%, rgba(255,255,255,0.03) 55%, transparent 64%)",
            transform: `translateX(${sheenX}%)`,
          }}
        />

        {/* Soft blurred diagonal light glow matching reference cards */}
        <div
          style={{
            position: "absolute",
            right: -40,
            top: -50,
            width: 280,
            height: 340,
            background:
              "radial-gradient(ellipse at center, rgba(255,255,255,0.11) 0%, transparent 72%)",
            filter: "blur(18px)",
            transform: "rotate(-22deg)",
          }}
        />

        {/* Right-side watermark illustration */}
        <CardWatermark type={iconType} frame={frame} />
      </div>

      {/* Glowing white dashed border around the Reference Price card */}
      {isPriceCard && (
        <svg
          width="100%"
          height="100%"
          style={{
            position: "absolute",
            inset: -2,
            width: "calc(100% + 4px)",
            height: "calc(100% + 4px)",
            overflow: "visible",
            pointerEvents: "none",
            opacity: priceHighlightOpacity,
          }}
        >
          <rect
            x="2"
            y="2"
            width="calc(100% - 4px)"
            height="calc(100% - 4px)"
            fill="none"
            stroke="#ffffff"
            strokeWidth="4.5"
            strokeDasharray="18 14"
            strokeDashoffset={-frame * 0.8}
            style={{
              filter: `drop-shadow(0 0 ${10 * pulseGlow}px rgba(255,255,255,0.95)) drop-shadow(0 0 ${
                22 * pulseGlow
              }px rgba(255,255,255,0.55))`,
            }}
          />
        </svg>
      )}

      {/* Header Row: Icon + Label + Horizontal Extending Line */}
      <div
        style={{
          position: "relative",
          display: "flex",
          alignItems: "center",
          gap: 12,
          marginBottom: 18,
          ...revealStyle(frame, startFrame + 4, 18, 12),
        }}
      >
        <HeaderIcon type={iconType} />
        <span
          style={{
            color: "#b8b8b8",
            fontSize: 31,
            fontWeight: 500,
            letterSpacing: 0.5,
          }}
        >
          {label}
        </span>
        <div
          style={{
            flex: 1,
            height: 1,
            marginLeft: 10,
            background:
              "linear-gradient(90deg, rgba(255,255,255,0.22) 0%, rgba(255,255,255,0.06) 100%)",
          }}
        />
      </div>

      {/* Main Spec Value */}
      <div
        style={{
          position: "relative",
          color: "#f5f5f5",
          fontSize: isPriceCard ? 66 : 49,
          fontWeight: 900,
          lineHeight: 1.16,
          letterSpacing: isPriceCard ? 0.5 : 0,
          marginBottom: isPriceCard ? 10 : 8,
          textShadow: "0 2px 10px rgba(0,0,0,0.35)",
          ...revealStyle(frame, startFrame + 9, 20, 16),
        }}
      >
        {value}
      </div>

      {/* Sub-details */}
      {lines.map((line, lineIdx) => (
        <div
          key={line}
          style={{
            position: "relative",
            color: isPriceCard ? "#adadad" : "#9c9c9c",
            fontSize: isPriceCard ? 28 : 22,
            fontWeight: 500,
            lineHeight: 1.48,
            ...revealStyle(frame, startFrame + 14 + lineIdx * 4, 18, 10),
          }}
        >
          {line}
        </div>
      ))}
    </div>
  );
};

export const PhoneSpecBoard: React.FC = () => {
  const frame = useCurrentFrame();
  const { fps } = useVideoConfig();
  const [handle] = useState(() => delayRender("Load Alibaba PuHuiTi fonts"));

  useEffect(() => {
    ensureFontsLoaded()
      .then(() => continueRender(handle))
      .catch((err) => cancelRender(err));
  }, [handle]);

  const leftEnter = spring({
    frame,
    fps,
    config: { damping: 24, stiffness: 95, mass: 1.05 },
  });

  const animatedPrice = Math.round(
    interpolate(frame, [52, 92], [0, phoneSpec.price], {
      easing: Easing.bezier(0.16, 1, 0.3, 1),
      extrapolateLeft: "clamp",
      extrapolateRight: "clamp",
    })
  );

  const subtitleProgress = interpolate(frame, [95, 118], [0, 1], {
    easing: Easing.bezier(0.16, 1, 0.3, 1),
    extrapolateLeft: "clamp",
    extrapolateRight: "clamp",
  });

  return (
    <AbsoluteFill
      style={{
        backgroundColor: "#0e0e0e",
        color: "#ffffff",
        fontFamily: "'Alibaba PuHuiTi', 'Microsoft YaHei', sans-serif",
        overflow: "hidden",
      }}
    >
      {/* Studio Gray Radial Lighting */}
      <AbsoluteFill
        style={{
          background:
            "radial-gradient(ellipse 78% 72% at 52% 42%, #2c2c2c 0%, #171717 55%, #080808 100%)",
        }}
      />

      {/* Fine Square Grid Pattern across the entire canvas */}
      <AbsoluteFill
        style={{
          backgroundImage:
            "linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px)",
          backgroundSize: "11px 11px",
          maskImage:
            "radial-gradient(ellipse 90% 85% at 50% 48%, rgba(0,0,0,0.95) 20%, rgba(0,0,0,0.25) 100%)",
          WebkitMaskImage:
            "radial-gradient(ellipse 90% 85% at 50% 48%, rgba(0,0,0,0.95) 20%, rgba(0,0,0,0.25) 100%)",
          pointerEvents: "none",
        }}
      />

      {/* Dark Sweeping Curve from Left-Middle to Bottom-Right */}
      <svg
        width="1920"
        height="1080"
        style={{ position: "absolute", inset: 0, pointerEvents: "none" }}
      >
        <defs>
          <linearGradient id="floorCurveFill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stopColor="rgba(0,0,0,0.55)" />
            <stop offset="100%" stopColor="rgba(0,0,0,0.92)" />
          </linearGradient>
        </defs>
        <path
          d="M -40 390 Q 340 650 860 910 L 1960 1080 L -40 1080 Z"
          fill="url(#floorCurveFill)"
        />
        <path
          d="M -40 390 Q 340 650 860 910"
          fill="none"
          stroke="rgba(255,255,255,0.08)"
          strokeWidth="1.5"
        />
      </svg>

      {/* Top-Left Watermark Shield Icon */}
      <div style={{ position: "absolute", left: 22, top: 20, opacity: 0.85 }}>
        <TopLeftLogo />
      </div>

      {/* LEFT COLUMN: Tier Box + Glowing Title + Dual Phones */}
      <div
        style={{
          position: "absolute",
          left: 66,
          top: 52,
          width: 566,
          opacity: leftEnter,
          transform: `translateX(${(1 - leftEnter) * -36}px)`,
        }}
      >
        {/* Top Price Tier Box */}
        <div
          style={{
            position: "relative",
            height: 174,
            padding: "24px 30px",
            boxSizing: "border-box",
            background:
              "linear-gradient(135deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.04) 100%)",
            border: "1px solid rgba(255,255,255,0.22)",
            boxShadow: "0 12px 30px rgba(0,0,0,0.35)",
            display: "flex",
            alignItems: "stretch",
            gap: 16,
          }}
        >
          {/* Left vertical accent bar spanning full content height */}
          <div
            style={{
              width: 8,
              marginTop: 12,
              marginBottom: 8,
              background: "linear-gradient(180deg, #6e6e6e 0%, #999999 100%)",
              ...revealStyle(frame, 4, 18, 10),
            }}
          />

          <div
            style={{
              display: "flex",
              flexDirection: "column",
              justifyContent: "space-between",
              paddingTop: 2,
              paddingBottom: 4,
            }}
          >
            <div
              style={{
                color: "#9a9a9a",
                fontSize: 23,
                fontWeight: 500,
                letterSpacing: 1,
                ...revealStyle(frame, 4, 18, 10),
              }}
            >
              {phoneSpec.tierLabel}
            </div>

            <div
              style={{
                color: "#d8d8d8",
                fontSize: 48,
                fontWeight: 900,
                letterSpacing: 1,
                lineHeight: 1.1,
                ...revealStyle(frame, 8, 22, 14),
              }}
            >
              {phoneSpec.tierValue}
            </div>
          </div>
        </div>

        {/* Glowing Phone Model Name */}
        <div
          style={{
            marginTop: 22,
            marginLeft: 18,
            fontSize: 72,
            fontWeight: 900,
            color: "#ffffff",
            letterSpacing: 1.5,
            textShadow:
              "0 0 18px rgba(255,255,255,0.85), 0 0 38px rgba(255,255,255,0.45), 0 4px 12px rgba(0,0,0,0.6)",
            ...revealStyle(frame, 14, 24, 18),
          }}
        >
          {phoneSpec.name}
        </div>

        {/* Dual 3D-Styled Phone Mockups */}
        <div style={{ marginTop: 8 }}>
          <DualPhonesRender frame={frame} />
        </div>
      </div>

      {/* VERTICAL DIVIDER LINE */}
      <div
        style={{
          position: "absolute",
          left: 682,
          top: 48,
          width: 1.5,
          height: 836,
          background:
            "linear-gradient(180deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.32) 15%, rgba(255,255,255,0.28) 85%, rgba(255,255,255,0.08) 100%)",
        }}
      />

      {/* RIGHT COLUMN: 2x3 Grid of Spec Cards */}
      <div
        style={{
          position: "absolute",
          left: 718,
          right: 68,
          top: 48,
          display: "grid",
          gridTemplateColumns: "1fr 1fr",
          columnGap: 28,
          rowGap: 32,
        }}
      >
        <SpecCard
          index={0}
          iconType="cpu"
          label="处理器"
          value="天玑 7360 SUPER"
          lines={["制程工艺：台积电 4nm"]}
        />
        <SpecCard
          index={1}
          iconType="screen"
          label="屏幕"
          value="6.72 英寸"
          lines={["分辨率：2400×1080 / 屏幕材料：LCD 屏", "屏幕刷新率：144Hz"]}
        />
        <SpecCard
          index={2}
          iconType="battery"
          label="电池与充电"
          value="7000mAh"
          lines={["有线充电：45 W", "无线充电：/"]}
        />
        <SpecCard
          index={3}
          iconType="camera"
          label="影像"
          value="主摄：50MP广角"
          lines={["长焦：/  超广角：/", "其它：2MP黑白镜头"]}
        />
        <SpecCard
          index={4}
          iconType="body"
          label="机身"
          value="约208g"
          lines={["长宽厚：165.85mm*76.00mm*8.55mm", "特色配置：NFC"]}
        />
        <SpecCard
          index={5}
          iconType="price"
          label="参考价格"
          value={`${animatedPrice}元`}
          lines={["储存版本：6+128GB"]}
          isPriceCard
        />
      </div>

      {/* BOTTOM CENTER SUBTITLE */}
      <div
        style={{
          position: "absolute",
          left: "50%",
          bottom: 48,
          transform: `translateX(-50%) translateY(${(1 - subtitleProgress) * 14}px)`,
          opacity: subtitleProgress,
          fontSize: 45,
          fontWeight: 700,
          color: "#ffffff",
          letterSpacing: 1,
          textShadow:
            "0 2px 6px rgba(0,0,0,0.95), 0 0 14px rgba(0,0,0,0.8)",
          whiteSpace: "nowrap",
        }}
      >
        {phoneSpec.subtitle}
      </div>

      {/* BOTTOM RIGHT FOOTNOTE */}
      <div
        style={{
          position: "absolute",
          right: 26,
          bottom: 44,
          color: "#b0b0b0",
          fontSize: 19,
          fontWeight: 500,
          letterSpacing: 0.5,
          opacity: subtitleProgress,
        }}
      >
        {phoneSpec.footnote}
      </div>
    </AbsoluteFill>
  );
};
