// Frame-driven reveal helper with crisp slide + blur fade-in
const revealStyle = (
  frame: number,
  startFrame: number,
  duration = 22,
  distanceY = 18
): React.CSSProperties => {
  const progress = interpolate(frame, [startFrame, startFrame + duration], [0, 1], {
    easing: Easing.bezier(0.16, 1, 0.3, 1),
    extrapolateLeft: "clamp",
    extrapolateRight: "clamp",
  });
  return {
    opacity: progress,
    transform: `translateY(${(1 - progress) * distanceY}px)`,
    filter: `blur(${(1 - progress) * 5}px)`,
  };
};

